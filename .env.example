# Neon PostgreSQL
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Exposed automatically from CLOUDINARY_CLOUD_NAME by next.config.ts. Set this
# only when a hosting provider requires explicit public environment variables.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional public music source URLs. For YouTube, use playlist URLs containing
# `list=...`; the official IFrame Player API supplies live track metadata and
# controls. RadioRasta never downloads, proxies, or extracts audio.
NEXT_PUBLIC_CODERSVOICE_URL=
# Server-side only. Used by the official YouTube Data API v3 to show exact
# queue titles and power song/artist search. Never prefix this variable with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
NEXT_PUBLIC_RADIORASTA_BUS_WALA_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_TRUCK_DRIVER_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_CHAI_TAPRI_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_DELUXE_SALOON_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_TRAIN_RADIO_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_DHABA_RADIO_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_BAARISH_WALI_KHIDKI_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_2AM_ROOFTOP_PLAYLIST_URL=
NEXT_PUBLIC_RADIORASTA_MOHALLE_WALA_PYAAR_PLAYLIST_URL=
